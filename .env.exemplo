# Grave suas chaves aqui (este arquivo, como .env, nunca vai para o GitHub).
# Só a do Groq é obrigatória; as outras ampliam o limite grátis (rodízio).

# Grátis, sem cartão: https://console.groq.com/keys
GROQ_API_KEY=

# Grátis, sem cartão (confirma pelo celular), ~1 bilhão de tokens/mês:
# https://console.mistral.ai/api-keys  (plano "Experiment")
MISTRAL_API_KEY=

# Grátis com a conta Google: https://aistudio.google.com/apikey
GEMINI_API_KEY=
